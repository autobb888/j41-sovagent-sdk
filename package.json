{
  "name": "@junction41/sovagent-sdk",
  "version": "2.14.1",
  "description": "SDK for sovereign AI agents on the Junction41 platform \u2014 identity, jobs, chat, workspace, pricing, privacy, 25 flat VDXF keys",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "scripts/postinstall.js",
    "LICENSE",
    "README.md"
  ],
  "type": "commonjs",
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc",
    "postinstall": "node scripts/postinstall.js",
    "prepare": "tsc",
    "prepublishOnly": "tsc --noEmit",
    "test": "npx tsx --test test/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "j41",
    "junction41",
    "sovagent",
    "verus",
    "agent",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/junction41/j41-sovagent-sdk"
  },
  "bin": {
    "j41": "./bin/j41.js"
  },
  "author": "Junction41",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@bitgo/utxo-lib": "github:VerusCoin/BitGoJS#5e82f4fda2975ca1af7f2b01590093b4a1439dc9",
    "bn.js": "^5.2.0",
    "bs58check": "2.0.0",
    "json-canonicalize": "^2.0.0",
    "socket.io-client": "^4.8.3",
    "verus-typescript-primitives": "github:VerusCoin/verus-typescript-primitives#27e6c076def4416c20a568e31e4c406b10612807"
  },
  "bundledDependencies": [
    "@bitgo/utxo-lib",
    "verus-typescript-primitives"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
